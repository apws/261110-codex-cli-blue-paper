+
+    #[test]
+    fn blue_paper_cursor_sequences_set_only_owned_colors_and_restore_defaults() {
+        let colors = ((0, 0, 0), (217, 235, 255));
+        assert_eq!(
+            set_sequence(colors, 2).unwrap(),
+            "\x1b]21;cursor=#000000;cursor_text=#d9ebff\x1b\\"
+        );
+        assert_eq!(set_sequence(colors, 1).unwrap(), "\x1b]12;#000000\x1b\\");
+        assert!(set_sequence(colors, 0).is_none());
+        assert_eq!(reset_sequence(2), b"\x1b]21;cursor;cursor_text\x1b\\");
+        assert_eq!(reset_sequence(1), b"\x1b]112\x1b\\");
+    }
+}
diff --git a/codex-rs/tui/src/style/blue_paper.rs b/codex-rs/tui/src/style/blue_paper.rs
new file mode 100644
index 0000000000000000000000000000000000000000..87ee31aec653f44b316324bf0decf4c554cf9169
--- /dev/null
+++ b/codex-rs/tui/src/style/blue_paper.rs
@@ -0,0 +1,423 @@
+//! Local, opt-in user-message paper/ink colors. Never affects agent/backend behavior.
+//!
+//! The external codex-blue wrapper sets these variables before process startup.
+//! Invalid colors or disabled/unsupported color output retain upstream rendering.
+
+use crate::terminal_palette::StdoutColorLevel;
+use crate::terminal_palette::XTERM_COLORS;
+use crate::terminal_palette::best_color_for_level;
+use crate::terminal_palette::effective_stdout_color_level;
+use ratatui::buffer::Buffer;
+use ratatui::buffer::Cell;
+use ratatui::layout::Rect;
+use ratatui::style::Color;
+use ratatui::style::Modifier;
+use ratatui::style::Style;
+use std::sync::OnceLock;
+
+pub(crate) type Rgb = (u8, u8, u8);
+const DEFAULT_PAPER: Rgb = (164, 205, 251);
+const DEFAULT_INK: Rgb = (16, 24, 32);
+
+#[derive(Clone, Copy)]
+struct Colors {
+    paper: Rgb,
+    ink: Rgb,
+}
+
+fn parse_hex(value: &str) -> Option<Rgb> {
+    let value = value.trim().strip_prefix('#').unwrap_or(value.trim());
+    if value.len() != 6 || !value.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+        return None;
+    }
+    Some((
+        u8::from_str_radix(&value[0..2], 16).ok()?,
+        u8::from_str_radix(&value[2..4], 16).ok()?,
+        u8::from_str_radix(&value[4..6], 16).ok()?,
+    ))
+}
+
+fn parse_colors(enabled: &str, paper: Option<&str>, ink: Option<&str>) -> Option<Colors> {
+    if !matches!(
+        enabled.trim().to_ascii_lowercase().as_str(),
+        "1" | "true" | "on"
+    ) {
+        return None;
+    }
+    Some(Colors {
+        paper: paper.map_or(Some(DEFAULT_PAPER), parse_hex)?,
+        ink: ink.map_or(Some(DEFAULT_INK), parse_hex)?,
+    })
+}
+
+fn style_for(colors: Option<Colors>, level: StdoutColorLevel, no_color: bool) -> Option<Style> {
+    if no_color
+        || !matches!(
+            level,
+            StdoutColorLevel::TrueColor | StdoutColorLevel::Ansi256
+        )
+    {
+        return None;
+    }
+    let colors = colors?;
+    let paper = best_color_for_level(colors.paper, level);
+    let actual_paper = match paper {
+        Color::Rgb(r, g, b) => (r, g, b),
+        Color::Indexed(index) if index >= 16 => XTERM_COLORS[usize::from(index)],
+        _ => return None,
+    };
+    // Preserve requested ink when readable; otherwise use upstream contrast correction.
+    let ink = super::contrast::foreground(colors.ink, Some(actual_paper), level);
+    Some(Style::default().fg(ink).bg(paper).not_dim())
+}
+
+pub(super) fn style() -> Option<Style> {
+    static COLORS: OnceLock<Option<Colors>> = OnceLock::new();
+    let colors = *COLORS.get_or_init(|| {
+        parse_colors(
+            &std::env::var("CODEX_BLUE_PAPER").unwrap_or_default(),
+            std::env::var("CODEX_BLUE_PAPER_BG").ok().as_deref(),
+            std::env::var("CODEX_BLUE_PAPER_FG").ok().as_deref(),
+        )
+    });
+    let no_color = std::env::var_os("NO_COLOR").is_some_and(|value| !value.is_empty());
+    style_for(colors, effective_stdout_color_level(), no_color)
+        .map(|style| if options().bold { style.bold() } else { style })
+}
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+enum CursorSetting {
+    #[default]
+    Terminal,
+    Auto,
+    Color(Rgb),
+}
+
+impl CursorSetting {
+    fn parse(value: &str) -> Self {
+        match value.trim().to_ascii_lowercase().as_str() {
+            "auto" => Self::Auto,
+            "terminal" => Self::Terminal,
+            _ => parse_hex(value).map_or(Self::Terminal, Self::Color),
+        }
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+struct Options {
+    emphasis: Option<Rgb>,
+    hint: Option<Rgb>,
+    cursor: CursorSetting,
+    cursor_text: Option<Rgb>,
+    bold: bool,
+}
+
+fn options() -> &'static Options {
+    static OPTIONS: OnceLock<Options> = OnceLock::new();
+    OPTIONS.get_or_init(|| {
+        let color = |name| std::env::var(name).ok().as_deref().and_then(parse_hex);
+        Options {
+            emphasis: color("CODEX_BLUE_PAPER_EMPHASIS_FG"),
+            hint: color("CODEX_BLUE_PAPER_HINT_FG"),
+            cursor: CursorSetting::parse(
+                &std::env::var("CODEX_BLUE_PAPER_CURSOR").unwrap_or_else(|_| "terminal".into()),
+            ),
+            cursor_text: color("CODEX_BLUE_PAPER_CURSOR_TEXT"),
+            bold: std::env::var("CODEX_BLUE_PAPER_BOLD")
+                .is_ok_and(|value| matches!(value.as_str(), "1" | "true" | "on")),
+        }
+    })
+}
+
+fn rgb(color: Color) -> Option<Rgb> {
+    match color {
+        Color::Rgb(r, g, b) => Some((r, g, b)),
+        Color::Indexed(index) if index >= 16 => Some(XTERM_COLORS[usize::from(index)]),
+        _ => None,
+    }
+}
+
+fn foreground(preferred: Option<Rgb>, surface: Style) -> Color {
+    preferred.map_or(surface.fg.unwrap_or(Color::Reset), |preferred| {
+        super::contrast::foreground(
+            preferred,
+            surface.bg.and_then(rgb),
+            effective_stdout_color_level(),
+        )
+    })
+}
+
+pub(super) fn emphasis_style() -> Option<Style> {
+    style().map(|surface| surface.fg(foreground(options().emphasis, surface)).bold())
+}
+
+pub(super) fn hint_style() -> Option<Style> {
+    style().map(|surface| surface.fg(foreground(options().hint, surface)).not_bold())
+}
+
+// These are explicit RGB equivalents for semantic ANSI accents on our own surface only.
+// Converting them avoids assuming that an arbitrary terminal ANSI palette fits blue paper.
+fn semantic_rgb(color: Color) -> Option<Rgb> {
+    rgb(color).or_else(|| {
+        Some(match color {
+            Color::Black => (0, 0, 0),
+            Color::Red => (128, 0, 0),
+            Color::Green => (0, 128, 0),
+            Color::Yellow => (128, 128, 0),
+            Color::Blue => (0, 0, 128),
+            Color::Magenta => (128, 0, 128),
+            Color::Cyan => (0, 128, 128),
+            Color::Gray => (192, 192, 192),
+            Color::DarkGray => (128, 128, 128),
+            Color::LightRed => (255, 0, 0),
+            Color::LightGreen => (0, 255, 0),
+            Color::LightYellow => (255, 255, 0),
+            Color::LightBlue => (0, 0, 255),
+            Color::LightMagenta => (255, 0, 255),
+            Color::LightCyan => (0, 255, 255),
+            Color::White => (255, 255, 255),
+            Color::Indexed(index) => XTERM_COLORS[usize::from(index)],
+            Color::Reset | Color::Rgb(..) => return None,
+        })
+    })
+}
+
+fn normalize_for(buf: &mut Buffer, area: Rect, surface: Style, options: Options) {
+    let ink = surface.fg.unwrap_or(Color::Reset);
+    let emphasis = foreground(options.emphasis, surface);
+    let area = area.intersection(buf.area);
+    for y in area.top()..area.bottom() {
+        for x in area.left()..area.right() {
+            let cell = &mut buf[(x, y)];
+            // Do not recolor popups, separate effects, or externally owned graphics cells.
+            if Some(cell.bg) != surface.bg
+                || cell.diff_option == ratatui::buffer::CellDiffOption::Skip
+                || cell.modifier.contains(Modifier::HIDDEN)
+            {
+                continue;
+            }
+            let plain = cell.fg == ink || cell.fg == Color::Reset;
+            cell.fg = if cell.fg == Color::Reset {
+                if cell.modifier.contains(Modifier::BOLD) {
+                    emphasis
+                } else {
+                    ink
+                }
+            } else if semantic_rgb(cell.fg) == Some((255, 255, 255))
+                && cell.modifier.contains(Modifier::BOLD)
+            {
+                emphasis
+            } else if plain {
+                ink
+            } else {
+                foreground(semantic_rgb(cell.fg), surface)
+            };
+            // Dim intensity is terminal-defined and may defeat corrected RGB contrast.
+            cell.modifier.remove(Modifier::DIM);
+            if plain && options.bold {
+                cell.modifier.insert(Modifier::BOLD);
+            }
+        }
+    }
+}
+
+/// Final pass for the composer's own blue cells, after keys, voice and markers have painted.
+/// Keep content, wrapping, selection reversal, underline and non-blue overlays unchanged.
+pub(super) fn normalize_composer(buf: &mut Buffer, area: Rect) {
+    if let Some(surface) = style() {
+        normalize_for(buf, area, surface, *options());
+    }
+}
+
+/// Resolve an opt-in cursor only over the blue composer/history surface, accounting for reversal.
+pub(crate) fn cursor_colors(cell: &Cell) -> Option<(Rgb, Rgb)> {
+    let surface = style()?;
+    if Some(cell.bg) != surface.bg
+        || cell.diff_option == ratatui::buffer::CellDiffOption::Skip
+        || cell.modifier.contains(Modifier::HIDDEN)
+    {
+        return None;
+    }
+    let mut background = rgb(cell.bg)?;
+    let mut ink = rgb(cell.fg).or_else(|| surface.fg.and_then(rgb))?;
+    if cell.modifier.contains(Modifier::REVERSED) {
+        std::mem::swap(&mut background, &mut ink);
+    }
+    let preferred = match options().cursor {
+        CursorSetting::Terminal => return None,
+        CursorSetting::Auto => ink,
+        CursorSetting::Color(color) => color,
+    };
+    let level = effective_stdout_color_level();
+    let cursor = rgb(super::contrast::foreground(
+        preferred,
+        Some(background),
+        level,
+    ))?;
+    let text = rgb(super::contrast::foreground(
+        options().cursor_text.unwrap_or(background),
+        Some(cursor),
+        level,
+    ))?;
+    Some((cursor, text))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::terminal_palette::rgb_color;
+
+    fn contrast_ratio(a: Rgb, b: Rgb) -> f64 {
+        let luminance = |(r, g, b): Rgb| {
+            let linear = |channel: u8| {
+                let value = f64::from(channel) / 255.0;
+                if value <= 0.04045 {
+                    value / 12.92
+                } else {
+                    ((value + 0.055) / 1.055).powf(2.4)
+                }
+            };
+            0.2126 * linear(r) + 0.7152 * linear(g) + 0.0722 * linear(b)
+        };
+        let (a, b) = (luminance(a), luminance(b));
+        (a.max(b) + 0.05) / (a.min(b) + 0.05)
+    }
+
+    #[test]
+    fn colors_accept_hex_and_reject_malformed_or_unicode_values() {
+        assert_eq!(parse_hex(" #a4CdFb "), Some(DEFAULT_PAPER));
+        for value in ["", "#abc", "gggggg", "11223344", "ž1234", "12345\n6"] {
+            assert_eq!(parse_hex(value), None, "{value}");
+        }
+        assert!(parse_colors("on", Some("not-a-color"), None).is_none());
+    }
+
+    #[test]
+    fn truecolor_uses_the_approved_paper_and_ink() {
+        let style = style_for(
+            parse_colors("1", None, None),
+            StdoutColorLevel::TrueColor,
+            false,
+        );
+        assert_eq!(
+            style,
+            Some(
+                Style::default()
+                    .fg(rgb_color(DEFAULT_INK))
+                    .bg(rgb_color(DEFAULT_PAPER))
+                    .not_dim()
+            )
+        );
+    }
+
+    #[test]
+    fn disabled_no_color_and_unsupported_terminals_retain_stock_rendering() {
+        let colors = parse_colors("true", None, None);
+        assert!(
+            style_for(
+                parse_colors("0", None, None),
+                StdoutColorLevel::TrueColor,
+                false
+            )
+            .is_none()
+        );
+        assert!(style_for(colors, StdoutColorLevel::TrueColor, true).is_none());
+        assert!(style_for(colors, StdoutColorLevel::Ansi16, false).is_none());
+        assert!(style_for(colors, StdoutColorLevel::Unknown, false).is_none());
+    }
+
+    #[test]
+    fn palette_reduction_preserves_readable_ink() {
+        let Some(style) = style_for(
+            parse_colors("on", None, None),
+            StdoutColorLevel::Ansi256,
+            false,
+        ) else {
+            panic!("expected a 256-color style");
+        };
+        let (Some(Color::Indexed(paper)), Some(Color::Indexed(ink))) = (style.bg, style.fg) else {
+            panic!("expected indexed colors");
+        };
+        assert!(
+            contrast_ratio(
+                XTERM_COLORS[usize::from(ink)],
+                XTERM_COLORS[usize::from(paper)]
+            ) >= 4.5
+        );
+    }
+
+    #[test]
+    fn unreadable_custom_ink_is_corrected_against_the_actual_fill() {
+        let Some(style) = style_for(
+            parse_colors("1", Some("A4CDFB"), Some("A4CDFB")),
+            StdoutColorLevel::TrueColor,
+            false,
+        ) else {
+            panic!("expected a truecolor style");
+        };
+        let Some(Color::Rgb(r, g, b)) = style.fg else {
+            panic!("expected RGB ink");
+        };
+        assert!(contrast_ratio((r, g, b), DEFAULT_PAPER) >= 4.5);
+    }
+
+    #[test]
+    fn blue_paper_light_and_dark_composer_overrides_keep_keys_readable() {
+        for (paper, ink) in [("D9EBFF", "000000"), ("12345A", "FFFFFF")] {
+            let surface = style_for(
+                parse_colors("1", Some(paper), Some(ink)),
+                StdoutColorLevel::TrueColor,
+                false,
+            )
+            .unwrap();
+            let area = Rect::new(0, 0, 5, 1);
+            let mut buf = Buffer::empty(area);
+            buf.set_style(area, surface);
+            buf.set_string(0, 0, "esc", Style::default().fg(Color::White).bold().dim());
+            buf[(3, 0)].set_symbol("x").set_style(surface.reversed());
+            buf[(4, 0)]
+                .set_symbol("o")
+                .set_style(Style::default().bg(Color::Red));
+            let outside = buf[(4, 0)].clone();
+            normalize_for(
+                &mut buf,
+                area,
+                surface,
+                Options {
+                    bold: true,
+                    ..Options::default()
+                },
+            );
+            for x in 0..4 {
+                let cell = &buf[(x, 0)];
+                let (Some(a), Some(b)) = (rgb(cell.fg), rgb(cell.bg)) else {
+                    panic!("RGB expected")
+                };
+                assert!(contrast_ratio(a, b) >= 4.5);
+                assert!(!cell.modifier.contains(Modifier::DIM));
+                assert!(cell.modifier.contains(Modifier::BOLD));
+            }
+            assert_eq!(buf[(0, 0)].symbol(), "e");
+            assert!(buf[(3, 0)].modifier.contains(Modifier::REVERSED));
+            assert_eq!(buf[(4, 0)], outside);
+        }
+    }
+
+    #[test]
+    fn blue_paper_optional_settings_have_conservative_fallbacks() {
+        assert_eq!(CursorSetting::parse("terminal"), CursorSetting::Terminal);
+        assert_eq!(CursorSetting::parse("auto"), CursorSetting::Auto);
+        assert_eq!(
+            CursorSetting::parse("#000000"),
+            CursorSetting::Color((0, 0, 0))
+        );
+        assert_eq!(CursorSetting::parse("\x1b]12;bad"), CursorSetting::Terminal);
+        let surface = style_for(
+            parse_colors("1", Some("D9EBFF"), Some("000000")),
+            StdoutColorLevel::TrueColor,
+            false,
+        )
+        .unwrap();
+        assert_eq!(foreground(None, surface), surface.fg.unwrap());
+    }
+}
