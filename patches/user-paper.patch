+    pub(super) fn update_blue_cursor(&mut self, position: Option<Position>) -> io::Result<()> {
+        let desired = position.and_then(|position| {
+            let buffer = &self.buffers[self.current];
+            buffer
+                .area
+                .contains(position)
+                .then(|| crate::style::blue_cursor_colors(&buffer[(position.x, position.y)]))
+                .flatten()
