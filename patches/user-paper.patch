+#[test]
+fn blue_paper_cursor_lifecycle() {
+    const CHILD: &str = "CODEX_BLUE_CURSOR_TEST_CHILD";
+    const TEST: &str = "custom_terminal::tests::cursor::blue_paper_cursor_lifecycle";
+    if std::env::var_os(CHILD).is_none() {
+        for mode in ["auto", "terminal", "disabled"] {
+            let output = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", TEST])
+                .env(CHILD, mode)
+                .env(
+                    "CODEX_BLUE_PAPER",
+                    if mode == "disabled" { "0" } else { "1" },
+                )
+                .env("CODEX_BLUE_PAPER_BG", "#D9EBFF")
+                .env("CODEX_BLUE_PAPER_FG", "#000000")
+                .env(
+                    "CODEX_BLUE_PAPER_CURSOR",
+                    if mode == "terminal" {
+                        "terminal"
+                    } else {
+                        "auto"
+                    },
+                )
+                .env("CODEX_BLUE_PAPER_CURSOR_TEXT", "auto")
+                .env("TERM", "xterm-kitty")
+                .env("FORCE_COLOR", "3")
+                .env_remove("NO_COLOR")
+                .env_remove("TMUX")
+                .env_remove("STY")
+                .output()
+                .unwrap();
+            assert!(
+                output.status.success(),
+                "{mode}: {}\n{}",
+                String::from_utf8_lossy(&output.stdout),
+                String::from_utf8_lossy(&output.stderr)
+            );
+        }
+        return;
+    }
+    let active = std::env::var(CHILD).unwrap() == "auto";
+    let mut terminal = Terminal::with_options(CaptureBackend::new(12, 2)).unwrap();
+    let area = Rect::new(0, 0, 12, 2);
+    terminal.set_viewport_area(area);
+    let blue = Style::default()
+        .fg(Color::Rgb(0, 0, 0))
+        .bg(Color::Rgb(217, 235, 255));
+    let dark = Style::default()
+        .fg(Color::Rgb(224, 224, 224))
+        .bg(Color::Rgb(18, 18, 18));
+    let draw_at = |terminal: &mut Terminal<CaptureBackend>, cursor: Option<(u16, u16)>| {
+        terminal.backend_mut().output.clear();
+        terminal
+            .draw(|frame| {
+                frame.buffer_mut().set_string(0, 0, "blue paper", blue);
+                frame.buffer_mut().set_string(0, 1, "dark field", dark);
+                if let Some(position) = cursor {
+                    frame.set_cursor_position(position);
+                }
+            })
+            .unwrap();
+        terminal.backend().output()
+    };
+    let first = draw_at(&mut terminal, Some((0, 0)));
+    assert_eq!(
+        first.contains("\x1b]21;cursor=#000000;cursor_text=#d9ebff"),
+        active
+    );
+    let unchanged = draw_at(&mut terminal, Some((1, 0)));
+    assert!(!unchanged.contains("\x1b]21;"));
+    let outside = draw_at(&mut terminal, Some((1, 1)));
+    assert_eq!(outside.contains("\x1b]21;cursor;cursor_text"), active);
+    draw_at(&mut terminal, Some((0, 0)));
+    terminal.invalidate_cursor_state();
+    let hidden = draw_at(&mut terminal, None);
+    assert_eq!(hidden.contains("\x1b]21;cursor;cursor_text"), active);
+    draw_at(&mut terminal, Some((0, 0)));
+    terminal.backend_mut().output.clear();
+    // Same reset helper as exit, panic, external-editor and suspend paths.
+    crate::style::reset_blue_cursor_colors(terminal.backend_mut()).unwrap();
+    assert_eq!(
+        terminal
+            .backend()
+            .output()
+            .contains("\x1b]21;cursor;cursor_text"),
+        active
+    );
+    let resumed = draw_at(&mut terminal, Some((0, 0)));
+    assert_eq!(resumed.contains("\x1b]21;cursor=#000000"), active);
+    terminal.backend_mut().output.clear();
+    terminal.reset_cursor_style().unwrap();
+    assert_eq!(
+        terminal
+            .backend()
+            .output()
+            .contains("\x1b]21;cursor;cursor_text"),
+        active
+    );
+}
