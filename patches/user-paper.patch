+            && (desired.is_some() == crate::style::blue_cursor_colors_active())
+        {
+            return Ok(());
+        }
+        if let Some(colors) = desired {
+            if crate::style::set_blue_cursor_colors(&mut self.backend, colors)? {
+                self.last_blue_cursor = desired;
+            } else {
+                crate::style::reset_blue_cursor_colors(&mut self.backend)?;
+                self.last_blue_cursor = None;
+            }
+        } else {
+            crate::style::reset_blue_cursor_colors(&mut self.backend)?;
+            self.last_blue_cursor = None;
+        }
+        Ok(())
+    }
