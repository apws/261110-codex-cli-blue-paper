+//! Opt-in cursor colors scoped to blue-paper cells and restored on terminal handoff.
+//! No queries are emitted, so no new terminal input responses need to be consumed.
+
+use super::blue_paper::Rgb;
+use std::io;
+use std::io::Write;
+use std::sync::atomic::AtomicU8;
+use std::sync::atomic::Ordering;
+
+// 0 = untouched, 1 = xterm OSC 12, 2 = Kitty OSC 21 (cursor and cursor text).
+// Shared with the free-standing panic/exit/suspend restore paths.
+static ACTIVE: AtomicU8 = AtomicU8::new(0);
+
+fn protocol() -> u8 {
+    let term = std::env::var("TERM").unwrap_or_default();
+    if std::env::var_os("TMUX").is_some()
+        || std::env::var_os("STY").is_some()
+        || term.starts_with("screen")
+        || term.starts_with("tmux")
+    {
+        return 0;
+    }
+    if term.contains("kitty") || std::env::var_os("KITTY_WINDOW_ID").is_some() {
+        2
+    } else if term.starts_with("xterm") || std::env::var_os("KONSOLE_VERSION").is_some() {
+        1
+    } else {
+        0
+    }
+}
+
+fn set_sequence((cursor, text): (Rgb, Rgb), protocol: u8) -> Option<String> {
+    let (r, g, b) = cursor;
+    match protocol {
+        2 => {
+            let (tr, tg, tb) = text;
+            Some(format!(
+                "\x1b]21;cursor=#{r:02x}{g:02x}{b:02x};cursor_text=#{tr:02x}{tg:02x}{tb:02x}\x1b\\"
+            ))
+        }
+        1 => Some(format!("\x1b]12;#{r:02x}{g:02x}{b:02x}\x1b\\")),
+        _ => None,
+    }
+}
+
+fn reset_sequence(protocol: u8) -> &'static [u8] {
+    match protocol {
+        2 => b"\x1b]21;cursor;cursor_text\x1b\\",
+        1 => b"\x1b]112\x1b\\",
+        _ => b"",
+    }
+}
+
+pub(crate) fn cursor_colors_active() -> bool {
+    ACTIVE.load(Ordering::Relaxed) != 0
+}
+
+pub(crate) fn set_cursor_colors(writer: &mut impl Write, colors: (Rgb, Rgb)) -> io::Result<bool> {
+    let protocol = protocol();
+    let Some(sequence) = set_sequence(colors, protocol) else {
+        return Ok(false);
+    };
+    // Mark ownership before writing so a partial write still triggers a cleanup attempt.
+    ACTIVE.store(protocol, Ordering::Relaxed);
+    writer.write_all(sequence.as_bytes())?;
+    Ok(true)
+}
+
+pub(crate) fn reset_cursor_colors(writer: &mut impl Write) -> io::Result<()> {
+    let protocol = ACTIVE.load(Ordering::Relaxed);
+    if protocol != 0 {
+        writer.write_all(reset_sequence(protocol))?;
+        ACTIVE.store(0, Ordering::Relaxed);
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
